# ==============================================================================
# P6692 GAMING APPLICATION - OFFICIAL JAZZCASH CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure with your official credentials.
# In AI Studio, set these in Secrets panel; in Hostinger, set in Node.js environment.

PORT=5000
NODE_ENV=production

# Admin Security & RBAC Configuration
ADMIN_SECRET_KEY=YOUR_SUPER_ADMIN_SECRET_KEY_HERE
JWT_SECRET=YOUR_JWT_HMAC_SHA256_SECRET_KEY_HERE

# JazzCash Gateway Environment: 'SANDBOX' or 'PRODUCTION'
JAZZCASH_ENVIRONMENT=PRODUCTION

# JazzCash Official Merchant Account Credentials (Provided by JazzCash Corporate)
JAZZCASH_MERCHANT_ID=YOUR_OFFICIAL_MERCHANT_ID
JAZZCASH_PASSWORD=YOUR_OFFICIAL_API_PASSWORD
JAZZCASH_INTEGRITY_SALT=YOUR_OFFICIAL_INTEGRITY_SALT
JAZZCASH_BUSINESS_NAME=Ahmed Shop
JAZZCASH_ACCOUNT_NUMBER=01104590863
JAZZCASH_RETURN_URL=https://api.p6692.com/api/jazzcash/callback

# JazzCash Production API Endpoints (Set automatically according to JAZZCASH_ENVIRONMENT, or customize here)
# Sandbox: https://sandbox.jazzcash.com.pk/ApplicationAPI/API/2.0/Purchase/DoMWalletTransaction
# Production C2B M-Wallet Purchase API:
JAZZCASH_C2B_API_URL=https://payments.jazzcash.com.pk/ApplicationAPI/API/2.0/Purchase/DoMWalletTransaction
# Production Hosted Checkout Form URL:
JAZZCASH_API_URL=https://payments.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform
# Production Transaction Status Inquiry API:
JAZZCASH_STATUS_INQUIRY_URL=https://payments.jazzcash.com.pk/ApplicationAPI/API/2.0/Purchase/TransactionStatusInquiry
# Production B2C Merchant to Account (Payout / Disbursement) API:
JAZZCASH_B2C_API_URL=https://payments.jazzcash.com.pk/ApplicationAPI/API/2.0/Payouts/MerchantToAccount

