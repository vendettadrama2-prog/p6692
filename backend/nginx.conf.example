# Nginx Configuration for api.p6692.com reverse proxy to Express.js (Port 5000)
# SSL Termination via Let's Encrypt / Certbot

server {
    listen 80;
    server_name api.p6692.com;

    # Redirect all HTTP requests to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name api.p6692.com;

    # SSL Certificates (managed e.g. via Certbot)
    ssl_certificate /etc/letsencrypt/live/api.p6692.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.p6692.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Proxy to Node.js / Express backend
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_cache_bypass $http_upgrade;
    }
}
